    fileName: '/data/daq/data_run%R_${app_name}_%#_fstrmOffBeamNUMIMINBIAS_%to.root' 

    fileProperties: {

      maxSubRuns: 1 

      maxRuns: 1 

      maxEvents: 50 #close files out a little faster for the prescaled stream 

    }
    fastCloning: false 

    compressionLevel: 501 

    SelectEvents: [offbeamnumiminbiasfullstream] 

  }
  normalOutputFILTERFAIL: {

    module_type: RootDAQOut 

    fileName: '/data/daq/data_run%R_${app_name}_%#_fstrmUNKNOWN_%to.root' 

    fileProperties: {

      maxSubRuns: 1 

      maxRuns: 1 

      maxEvents: 50 #close files out a little faster for the prescaled stream 

    }
    fastCloning: false 

    compressionLevel: 501 

    SelectEvents: [filterfailfullstream] 

  }
  normalOutputBNB: {

    module_type: RootDAQOut 

    fileName: '/data/daq/data_run%R_${app_name}_%#_fstrmBNB_%to.root' 

    fileProperties: {

      maxSubRuns: 1 

      maxRuns: 1 

      maxEvents: 50 #close files out a little faster for the prescaled stream

    }
    fastCloning: false 

    compressionLevel: 501 

    SelectEvents: [bnbfullstream] 

  }
  normalOutputNUMI: {

    module_type: RootDAQOut 

    fileName: '/data/daq/data_run%R_${app_name}_%#_fstrmNUMI_%to.root' 

    fileProperties: {

