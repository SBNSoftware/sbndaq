      maxRuns: 1 

      maxEvents: 50 #close files out a little faster for the prescaled stream

    }
    fastCloning: false 

    compressionLevel: 501 

    SelectEvents: [offbeambnbfullstream] 

  }
  normalOutputOffBeamNUMI: {

    module_type: RootDAQOut 

    fileName: '/data/daq/data_run%R_${app_name}_%#_fstrmOffBeamNUMI_%to.root' 

