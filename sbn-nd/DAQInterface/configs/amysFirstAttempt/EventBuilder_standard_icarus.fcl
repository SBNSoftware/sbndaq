  }
  normalOutputCalib: {

    module_type: RootDAQOut 

    fileName: '/data/daq/data_run%R_${app_name}_%#_fstrmCalib_%to.root' 

    fileProperties: {

      maxSubRuns: 1 

      maxRuns: 1 

      maxEvents: 50 

    }
    fastCloning: false 

    compressionLevel: 501 

    SelectEvents: [calibstream] 

  }
  testOutput: {

    module_type: RootDAQOut 

    fileName: '/data/test_daq/data_run%R_${app_name}_%#_%to.root' 

    fileProperties: {

      maxSubRuns: 1 

      maxRuns: 1 

      maxEvents: 100 

    }
    fastCloning: false 

    compressionLevel: 501 

    SelectEvents: [] 

  }
  testOutputBNB: {

    module_type: RootDAQOut 

    fileName: '/data/test_daq/data_run%R_${app_name}_%#_fstrmBNB_%to.root' 

    fileProperties: {

      maxSubRuns: 1 

      maxRuns: 1 

      maxEvents: 50 

    }
    fastCloning: false 

    compressionLevel: 501 

    SelectEvents: [bnbfullstream] 

  }
  testOutputNUMI: {

    module_type: RootDAQOut 

    fileName: '/data/test_daq/data_run%R_${app_name}_%#_fstrmNUMI_%to.root' 

    fileProperties: {

      maxSubRuns: 1 

      maxRuns: 1 

      maxEvents: 50 

    }
    fastCloning: false 

    compressionLevel: 501 

    SelectEvents: [numifullstream] 

  }
  rootNetOutput: {

    module_type: RootNetOutput 

    broadcast_sends: true 

    nonblocking_sends: true 

    destinations: {

    }
    SelectEvents: [pdisp] 

    host_map: [{

	rank: -1 

	host: "sbnd-evb01-daq" 

      }] 

    routing_table_config: {
      ## True if using the Routing Manager
      use_routing_manager: false 

      route_on_request_mode: true 
      ## Port that table updates should arrive on
      table_update_port: 35556 # default
      ## Address that table updates should arrive on
      table_update_address: "227.128.12.35" 
      ## Port that acknowledgements should be sent to
      table_acknowledge_port: 35557 # default
      ## Host that acknowledgements should be sent to
      routing_manager_hostname: "sbnd-evb01-daq" # default
      # default
      table_update_multicast_interface: "0.0.0.0" 
      ## Time to wait (in ms) for a routing table update if the table is exhausted
      routing_timeout_ms: 1000 # default
      ## Number of times to retry getting destination from routing table
      routing_retry_count: 5 # default

    }
  }
}
physics: {

  analyzers: {

    artdaqFragWatcher: {

      module_type: FragmentWatcher 

      fragment_ids: [] 

    }
    incEventAna: {

      module_type: "IncompleteEventAna" 

    }
    fragWatcher: {

      module_type: "SBNDFragmentWatcher" 

    }
  }
  producers: {

  }
  filters: {

    prescale50: {

      module_type: "Prescaler" 

      prescaleFactor: 50 

      prescaleOffset: 0 

    }
    prescale10: {

      module_type: "Prescaler" 

      prescaleFactor: 10 

      prescaleOffset: 0 

    }
    prescale25: {

      module_type: "Prescaler" 

      prescaleFactor: 25 

      prescaleOffset: 0 

    }
    prescale5: {

      module_type: "Prescaler" 

      prescaleFactor: 5 

      prescaleOffset: 0 

    }
    prescale2: {

      module_type: "Prescaler" 

      prescaleFactor: 2 

      prescaleOffset: 0 

    }
    prescale1: {

      module_type: "Prescaler" 

      prescaleFactor: 1 

      prescaleOffset: 0 

    }
    bnbmajorityfilter: @local::bnbmajorityfilter 

    numimajorityfilter: @local::numimajorityfilter 

    offbeambnbmajorityfilter: @local::offbeambnbmajorityfilter 

    offbeamnumimajorityfilter: @local::offbeamnumimajorityfilter 

    bnbminbiasfilter: @local::bnbminbiasfilter 

    numiminbiasfilter: @local::numiminbiasfilter 

    offbeambnbminbiasfilter: @local::offbeambnbminbiasfilter 

    offbeamnumiminbiasfilter: @local::offbeamnumiminbiasfilter 

    bnbfilter: @local::bnbfilter 

    bnbmajeastfilter: @local::bnbmajeastfilter 

    bnbmajwestfilter: @local::bnbmajwestfilter 

    bnbmajbothfilter: @local::bnbmajbothfilter 

    bnbmineastfilter: @local::bnbmineastfilter 

    bnbminwestfilter: @local::bnbminwestfilter 

    bnbminbothfilter: @local::bnbminbothfilter 

    numifilter: @local::numifilter 

    numimajeastfilter: @local::bnbmajeastfilter 

    numimajwestfilter: @local::bnbmajwestfilter 

    numimajbothfilter: @local::bnbmajbothfilter 

    numimineastfilter: @local::numimineastfilter 

    numiminwestfilter: @local::numiminwestfilter 

    numiminbothfilter: @local::numiminbothfilter 

    offbeambnbfilter: @local::offbeambnbfilter 

    offbeambnbmajeastfilter: @local::offbeambnbmajeastfilter 

    offbeambnbmajwestfilter: @local::offbeambnbmajwestfilter 

    offbeambnbmajbothfilter: @local::offbeambnbmajbothfilter 

    offbeambnbmineastfilter: @local::offbeambnbmineastfilter 

    offbeambnbminwestfilter: @local::offbeambnbminwestfilter 

    offbeambnbminbothfilter: @local::offbeambnbminbothfilter 

    offbeamnumifilter: @local::offbeamnumifilter 

    offbeamnumimajeastfilter: @local::offbeamnumimajeastfilter 

    offbeamnumimajwestfilter: @local::offbeamnumimajwestfilter 

    offbeamnumimajbothfilter: @local::offbeamnumimajbothfilter 

    offbeamnumimineastfilter: @local::offbeamnumimineastfilter 

    offbeamnumiminwestfilter: @local::offbeamnumiminwestfilter 

    offbeamnumiminbothfilter: @local::offbeamnumiminbothfilter 

    calibeastfilter: @local::calibeastfilter 

    calibwestfilter: @local::calibwestfilter 

    calibbothfilter: @local::calibbothfilter 

  }
  p1: [] 

  pwrite: [prescale1] 

  pdisp: [prescale2] 

  filterfailfullstream: ["!bnbmajorityfilter", "!numimajorityfilter", "!offbeambnbmajorityfilter", "!offbeamnumimajorityfilter", "!bnbminbiasfilter", "!numiminbiasfilter", "!offbeambnbminbiasfilter", "!offbeamnumiminbiasfilter"] 

  bnbmajorityfullstream: [bnbmajorityfilter] 

  numimajorityfullstream: [numimajorityfilter] 

  offbeambnbmajorityfullstream: [offbeambnbmajorityfilter] 

  offbeamnumimajorityfullstream: [offbeamnumimajorityfilter] 

  bnbminbiasfullstream: [bnbminbiasfilter] 

  numiminbiasfullstream: [numiminbiasfilter] 

  offbeambnbminbiasfullstream: [offbeambnbminbiasfilter] 

  offbeamnumiminbiasfullstream: [offbeamnumiminbiasfilter] 

  bnbfullstream: [bnbfilter] 

  numifullstream: [numifilter] 

  offbeambnbfullstream: [offbeambnbfilter] 

  offbeamnumifullstream: [offbeamnumifilter] 

  calibstream: [calibeastfilter, calibwestfilter, calibbothfilter] 

  trigger_paths: [pdisp, bnbmajorityfullstream, numimajorityfullstream, offbeambnbmajorityfullstream, offbeamnumimajorityfullstream, bnbminbiasfullstream, numiminbiasfullstream, offbeambnbminbiasfullstream, offbeamnumiminbiasfullstream, filterfailfullstream] 

  a1: [incEventAna, artdaqFragWatcher, fragWatcher] 

  my_output_modules: [rootNetOutput, normalOutputBNBMAJORITY, normalOutputNUMIMAJORITY, normalOutputOffBeamBNBMAJORITY, normalOutputOffBeamNUMIMAJORITY, normalOutputBNBMINBIAS, normalOutputNUMIMINBIAS, normalOutputOffBeamBNBMINBIAS, normalOutputOffBeamNUMIMINBIAS, normalOutputFILTERFAIL] 

  end_paths: [my_output_modules, a1] 

}
source: {

  module_type: ArtdaqInput 

  waiting_time: 2500000 

  resume_after_timeout: true 

}
process_name: DAQ 
