 
#include "pmt06_default.fcl" 
#Baseline value is around 14250 ADC, so to set a 30 ADC threshold set the value to 14220
daq.fragment_receiver.triggerThreshold0: 14205 

daq.fragment_receiver.triggerThreshold1: 14205 

daq.fragment_receiver.triggerThreshold2: 14205 

daq.fragment_receiver.triggerThreshold3: 14205 

daq.fragment_receiver.triggerThreshold4: 14205 

daq.fragment_receiver.triggerThreshold5: 14205 

daq.fragment_receiver.triggerThreshold6: 14205 

daq.fragment_receiver.triggerThreshold7: 14205 

daq.fragment_receiver.triggerThreshold8: 14205 

daq.fragment_receiver.triggerThreshold9: 14205 

daq.fragment_receiver.triggerThreshold10: 14205 

daq.fragment_receiver.triggerThreshold11: 14205 

daq.fragment_receiver.triggerThreshold12: 14205 

daq.fragment_receiver.triggerThreshold13: 14205 

daq.fragment_receiver.triggerThreshold14: 14205 

daq.fragment_receiver.triggerThreshold15: 2000 #set this back to 2000 to prevent weird ghost MON out
#May just change waveform saving rather than actual outputs
daq.fragment_receiver.channelEnable0: true 

daq.fragment_receiver.channelEnable1: true 

daq.fragment_receiver.channelEnable2: true 

daq.fragment_receiver.channelEnable3: true 

