 
#include "pmt08_default.fcl" 
#Baseline value is around 14250 ADC, so to set a 30 ADC threshold set the value to 14220
daq.fragment_receiver.triggerThreshold0: 14200 

daq.fragment_receiver.triggerThreshold1: 14200 

daq.fragment_receiver.triggerThreshold2: 14200 

daq.fragment_receiver.triggerThreshold3: 14200 

daq.fragment_receiver.triggerThreshold4: 14200 

